generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  HELPER
  MODERATOR
  ADMIN
  OWNER
}

enum Edition {
  JAVA
  BEDROCK
}

enum StaffRole {
  OWNER
  DEVELOPER
  MANAGER
  ADMIN
  MODERATOR
  HELPER
  BUILDER
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  ACCEPTED
  REJECTED
}

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  emailVerified   DateTime?
  username        String            @unique
  passwordHash    String?
  avatarUrl       String?
  role            Role              @default(USER)
  banned          Boolean           @default(false)
  banReason       String?
  discordId       String?           @unique
  discordName     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  accounts        Account[]
  sessions        Session[]
  minecraft       MinecraftAccount?
  staff           Staff?
  carts           Cart[]
  orders          Order[]
  votes           Vote[]
  reports         Report[]          @relation("Reporter")
  assignedReports Report[]          @relation("Assignee")
  reportComments  ReportComment[]
  news            News[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([role])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Ownership verified in-game: player runs /link <code> (code in Redis, short TTL)
model MinecraftAccount {
  id         String           @id @default(cuid())
  userId     String           @unique
  uuid       String           @unique
  username   String
  edition    Edition          @default(JAVA)
  verifiedAt DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes      Vote[]
  deliveries RewardDelivery[]

  @@index([username])
}

model Staff {
  id            String    @id @default(cuid())
  userId        String?   @unique
  minecraftUuid String    @unique
  minecraftName String
  role          StaffRole
  edition       Edition   @default(JAVA)
  description   String?
  discordName   String?
  sortOrder     Int       @default(0)
  joinedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([role, sortOrder])
}

model GameMode {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  imageUrl    String?
  serverId    String?
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  server      Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([sortOrder])
}

model Server {
  id            String             @id @default(cuid())
  name          String             @unique
  host          String
  javaPort      Int                @default(25565)
  bedrockPort   Int?
  version       String?
  apiKeyHash    String?
  online        Boolean            @default(false)
  playersOnline Int                @default(0)
  playersMax    Int                @default(0)
  tps           Float?
  lastSeenAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  gameModes     GameMode[]
  commands      MinecraftCommand[]
}

model NewsCategory {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  news News[]
}

model News {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  excerpt    String
  content    String
  coverUrl   String?
  status     NewsStatus    @default(DRAFT)
  publishAt  DateTime?
  authorId   String
  categoryId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  author     User          @relation(fields: [authorId], references: [id])
  category   NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishAt])
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  description     String
  imageUrl        String?
  priceCents      Int
  discountPercent Int                @default(0)
  currency        String             @default("USD")
  categoryId      String
  active          Boolean            @default(true)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  category        ProductCategory    @relation(fields: [categoryId], references: [id])
  commands        MinecraftCommand[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([categoryId, active])
}

// Commands run on delivery. {player} and {uuid} are substituted server-side.
model MinecraftCommand {
  id        String   @id @default(cuid())
  productId String?
  serverId  String?
  command   String
  sortOrder Int      @default(0)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  server    Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  couponId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  value     Int
  maxUses   Int?
  usedCount Int          @default(0)
  expiresAt DateTime?
  active    Boolean      @default(true)
  carts     Cart[]
  orders    Order[]
}

model Order {
  id            String           @id @default(cuid())
  userId        String
  status        OrderStatus      @default(PENDING)
  subtotalCents Int
  discountCents Int              @default(0)
  totalCents    Int
  currency      String           @default("USD")
  couponId      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id])
  coupon        Coupon?          @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  deliveries    RewardDelivery[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  unitCents Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  provider    PaymentProvider
  providerRef String
  eventId     String?         @unique
  amountCents Int
  currency    String
  status      OrderStatus     @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  order       Order           @relation(fields: [orderId], references: [id])

  @@unique([provider, providerRef])
  @@index([orderId])
}

// idempotencyKey = orderItemId:commandId -> prevents duplicate rewards
model RewardDelivery {
  id                 String           @id @default(cuid())
  orderId            String
  minecraftAccountId String
  idempotencyKey     String           @unique
  command            String
  status             DeliveryStatus   @default(PENDING)
  attempts           Int              @default(0)
  lastError          String?
  deliveredAt        DateTime?
  nextAttemptAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  order              Order            @relation(fields: [orderId], references: [id])
  minecraftAccount   MinecraftAccount @relation(fields: [minecraftAccountId], references: [id])

  @@index([status, nextAttemptAt])
}

model VotingSite {
  id            String       @id @default(cuid())
  name          String
  url           String
  serviceName   String       @unique
  cooldownHours Int          @default(24)
  enabled       Boolean      @default(true)
  sortOrder     Int          @default(0)
  votes         Vote[]
  rewards       VoteReward[]
}

model Vote {
  id                 String            @id @default(cuid())
  siteId             String
  minecraftAccountId String?
  userId             String?
  username           String
  verifiedAt         DateTime          @default(now())
  site               VotingSite        @relation(fields: [siteId], references: [id])
  minecraftAccount   MinecraftAccount? @relation(fields: [minecraftAccountId], references: [id])
  user               User?             @relation(fields: [userId], references: [id])

  @@index([username, siteId, verifiedAt])
}

model VoteReward {
  id       String     @id @default(cuid())
  siteId   String
  minVotes Int        @default(1)
  command  String
  site     VotingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Report {
  id             String          @id @default(cuid())
  reporterId     String
  reportedPlayer String
  type           String
  description    String
  evidenceUrl    String?
  status         ReportStatus    @default(OPEN)
  assigneeId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reporter       User            @relation("Reporter", fields: [reporterId], references: [id])
  assignee       User?           @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments       ReportComment[]

  @@index([status, createdAt])
  @@index([reporterId])
}

model ReportComment {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  body      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([reportId])
}

model Rule {
  id        String @id @default(cuid())
  category  String
  title     String
  body      String
  sortOrder Int    @default(0)

  @@index([category, sortOrder])
}

model Partner {
  id        String  @id @default(cuid())
  name      String
  logoUrl   String
  url       String
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)
}

model WebsiteSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
